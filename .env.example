# Copy this file to .env and fill it in. Never commit .env.
GOOGLE_API_KEY=your_key_from_aistudio.google.com
# Check the exact name of the free model in Google AI Studio
GEMINI_MODEL=gemini-3.8-flash
# Used in this order when the main model is out of quota (20 requests/day per model) or overloaded
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

# Optional: LangSmith tracing (records every agent call for the report)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=qdc-rebel
